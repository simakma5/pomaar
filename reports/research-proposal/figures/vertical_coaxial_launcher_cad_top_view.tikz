\begin{tikzpicture}[
    scale=1.15,
    >=Stealth,
    font=\small
]

% ----------------------------------------------------
% DESIGN PARAMETERS (TURNING KNOB FOR VIA CAGE SPACING)
% ----------------------------------------------------
\def\ViaCageRadius{1.30cm}  % Radius of circular via cage
\def\ViaCageAngleStep{24}   % Angular step between cage vias in degrees (increase to space vias further apart)

% Outer PCB Substrate boundary
\draw[line width=0.6pt, fill=white] (-3.2, -1.6) rectangle (3.2, 1.6);

% Top & Bottom lateral via fences
\foreach \x in {-2.8, -2.2, -1.6, -1.0, 1.0, 1.6, 2.2, 2.8} {
    \filldraw[fill=white, draw=black, line width=0.4pt] (\x, 0.85) circle (0.07);
    \filldraw[fill=white, draw=black, line width=0.4pt] (\x, -0.85) circle (0.07);
}

% Circular via cage around coaxial launcher (controlled by \ViaCageAngleStep knob)
\foreach \ang in {
    90-\ViaCageAngleStep, 90, 90+\ViaCageAngleStep,
    270-\ViaCageAngleStep, 270, 270+\ViaCageAngleStep
} {
    \filldraw[fill=white, draw=black, line width=0.4pt] (\ang:\ViaCageRadius) circle (0.07);
}

% Buried stripline feed trace (dashed boundaries running horizontally, flaring at center coax port)
\draw[dashed, black, line width=0.6pt]
    (-3.2, 0.14) -- (-1.1, 0.14) .. controls (-0.6, 0.14) and (-0.4, 0.45) .. (0, 0.45) .. controls (0.4, 0.45) and (0.6, 0.14) .. (1.1, 0.14) -- (3.2, 0.14);
\draw[dashed, black, line width=0.6pt]
    (-3.2, -0.14) -- (-1.1, -0.14) .. controls (-0.6, -0.14) and (-0.4, -0.45) .. (0, -0.45) .. controls (0.4, -0.45) and (0.6, -0.14) .. (1.1, -0.14) -- (3.2, -0.14);

% Outer ground antipad / clearance ring
\draw[line width=0.5pt] (0, 0) circle (1.05);

% Coaxial dielectric clearance ring
\draw[line width=0.4pt] (0, 0) circle (0.45);

% Central coaxial pin contact ring & inner conductor pin
\draw[line width=0.4pt] (0, 0) circle (0.24);
\filldraw[fill=gray!40, draw=black, line width=0.5pt] (0, 0) circle (0.16);

\end{tikzpicture}
