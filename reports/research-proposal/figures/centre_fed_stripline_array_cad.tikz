\begin{tikzpicture}[
    scale=0.92,
    x={(0.96cm, 0.24cm)},
    y={(-0.55cm, 0.38cm)},
    z={(0cm, 1cm)},
    font=\small
]

% ----------------------------------------------------
% PARAMETERS FOR 8-ELEMENT CENTRE-FED STRIPLINE ARRAY CAD MODEL
% ----------------------------------------------------
\def\subL{7.2}   % Substrate half-length along X
\def\subW{1.3}   % Substrate half-width along Y
\def\subH{0.18}  % Substrate thickness
\def\patL{0.45}  % Patch half-length along X
\def\patW{0.50}  % Patch half-width along Y

% Vertical elevation levels (Exploded layers)
\pgfmathsetmacro{\zTop}{2.4}
\pgfmathsetmacro{\zTopBot}{\zTop - \subH}
\pgfmathsetmacro{\zBot}{0.0}
\pgfmathsetmacro{\zBotSubH}{\zBot - \subH}


% ----------------------------------------------------
% TOP SUBSTRATE (Antenna Substrate & 8 Microstrip Patches)
% ----------------------------------------------------
% Front-left thickness face
\filldraw[fill=gray!25, draw=black, line width=0.5pt]
    (-\subL, \subW, \zTop) -- (-\subL, -\subW, \zTop) -- (-\subL, -\subW, \zTopBot) -- (-\subL, \subW, \zTopBot) -- cycle;

% Front-right thickness face
\filldraw[fill=gray!20, draw=black, line width=0.5pt]
    (-\subL, -\subW, \zTop) -- (\subL, -\subW, \zTop) -- (\subL, -\subW, \zTopBot) -- (-\subL, -\subW, \zTopBot) -- cycle;

% Top surface
\filldraw[fill=white, draw=black, line width=0.5pt]
    (-\subL, -\subW, \zTop) -- (\subL, -\subW, \zTop) -- (\subL, \subW, \zTop) -- (-\subL, \subW, \zTop) -- cycle;

% 8 Microstrip Patch Antenna Elements
\foreach \xPos in {-5.8, -4.2, -2.6, -1.0, 1.0, 2.6, 4.2, 5.8} {
    \filldraw[fill=gray!40, draw=black, line width=0.5pt]
        ({\xPos-\patL}, -\patW, \zTop) -- ({\xPos+\patL}, -\patW, \zTop)
        -- ({\xPos+\patL}, \patW, \zTop) -- ({\xPos-\patL}, \patW, \zTop) -- cycle;
}

% Elliptical 3D Central Coaxial Launcher pin hole on top layer (x = 0)
\filldraw[fill=gray!30, draw=black, line width=0.5pt]
    plot[domain=0:360, samples=36] ({0.14*cos(\x)}, {0.14*sin(\x)}, \zTop);


% ----------------------------------------------------
% BOTTOM SUBSTRATE (Feed Substrate & Ground Plane)
% ----------------------------------------------------
% Front-left thickness face
\filldraw[fill=gray!25, draw=black, line width=0.5pt]
    (-\subL, \subW, \zBot) -- (-\subL, -\subW, \zBot) -- (-\subL, -\subW, \zBotSubH) -- (-\subL, \subW, \zBotSubH) -- cycle;

% Front-right thickness face
\filldraw[fill=gray!20, draw=black, line width=0.5pt]
    (-\subL, -\subW, \zBot) -- (\subL, -\subW, \zBot) -- (\subL, -\subW, \zBotSubH) -- (-\subL, -\subW, \zBotSubH) -- cycle;

% Ground plane top surface
\filldraw[fill=white, draw=black, line width=0.5pt]
    (-\subL, -\subW, \zBot) -- (\subL, -\subW, \zBot) -- (\subL, \subW, \zBot) -- (-\subL, \subW, \zBot) -- cycle;


% ----------------------------------------------------
% CENTRAL BURIED STRIPLINE TRACE (Straight feedline passing unimpeded through center)
% ----------------------------------------------------
\draw[dashed, black, line width=0.6pt]
    (-6.2, 0, \zBot) -- (6.2, 0, \zBot);


% ----------------------------------------------------
% PARALLEL VIA FENCES (Lateral Shielding Vias along Stripline Channel)
% ----------------------------------------------------
% Top via row at y = +0.55
\foreach \xPos in {-6.4, -5.8, -5.2, -4.6, -4.0, -3.4, -2.8, -2.2, -1.6, -1.1, 1.1, 1.6, 2.2, 2.8, 3.4, 4.0, 4.6, 5.2, 5.8, 6.4} {
    \filldraw[fill=white, draw=black, line width=0.4pt]
        plot[domain=0:360, samples=20] ({\xPos + 0.08*cos(\x)}, {0.55 + 0.08*sin(\x)}, \zBot);
}

% Bottom via row at y = -0.55
\foreach \xPos in {-6.4, -5.8, -5.2, -4.6, -4.0, -3.4, -2.8, -2.2, -1.6, -1.1, 1.1, 1.6, 2.2, 2.8, 3.4, 4.0, 4.6, 5.2, 5.8, 6.4} {
    \filldraw[fill=white, draw=black, line width=0.4pt]
        plot[domain=0:360, samples=20] ({\xPos + 0.08*cos(\x)}, {-0.55 + 0.08*sin(\x)}, \zBot);
}

% Elliptical Via Arches above and below central coaxial launcher (R = 0.95cm)
% Omit 25, 155, 205, 335 degrees (2 on each side) to keep the aperture slots at x = +/- 1.0 completely clear!
\foreach \ang in {50, 75, 105, 130, 230, 255, 285, 310} {
    \filldraw[fill=white, draw=black, line width=0.4pt]
        plot[domain=0:360, samples=20] ({0.95*cos(\ang) + 0.07*cos(\x)}, {0.95*sin(\ang) + 0.07*sin(\x)}, \zBot);
}

% Central Coaxial Feed Launcher Port (3D Elliptical projection)
\filldraw[fill=gray!20, draw=black, line width=0.5pt]
    plot[domain=0:360, samples=40] ({0.42*cos(\x)}, {0.42*sin(\x)}, \zBot);
\filldraw[fill=black, draw=black]
    plot[domain=0:360, samples=36] ({0.15*cos(\x)}, {0.15*sin(\x)}, \zBot);


% ----------------------------------------------------
% 8 RECTANGULAR APERTURE SLOTS (Shorter length: y = -0.28 to +0.28)
% ----------------------------------------------------
\foreach \xPos in {-5.8, -4.2, -2.6, -1.0, 1.0, 2.6, 4.2, 5.8} {
    \filldraw[fill=white, draw=black, line width=0.5pt]
        ({\xPos-0.05}, -0.28, \zBot) -- ({\xPos+0.05}, -0.28, \zBot)
        -- ({\xPos+0.05}, 0.28, \zBot) -- ({\xPos-0.05}, 0.28, \zBot) -- cycle;
}

\end{tikzpicture}
